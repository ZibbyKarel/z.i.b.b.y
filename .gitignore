# Env / secrets — never commit
.env
.env.local
.env.*.local

# Local Claude Code session state (permissions granted interactively, MCP auth tokens)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Local-only Claude Design handoff bundle (not committed)
design-ref/

# Playwright e2e
/.e2e-data/
/playwright-report/
/test-results/
/e2e/.auth/

z-i-b-b-y
# Playwright MCP session artifacts (snapshots/console logs)
/.playwright-mcp/

# Stray fake-claude run artifacts (the e2e CLAUDE_BIN stub writes a marker + intent
# files into the api server's cwd when a gated agent run isn't sandboxed to a worktree)
/apps/api/agent-007-was-here.txt
/apps/api/intent-request.json
/apps/api/payment-done.txt

# graphify: only GRAPH_REPORT.md (+ cost.json) is committed — the rest is
# machine-specific (interpreter path, absolute-path manifest) or regenerable.
/graphify-out/graph.json
/graphify-out/manifest.json
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.graphify_*.json
/graphify-out/.graphify_*.txt

# live runtime data root (resolveDataRoot() default anchor — real operator data,
# regenerated locally e.g. by `pnpm self-knowledge:generate`; never versioned)
/apps/api/data/
