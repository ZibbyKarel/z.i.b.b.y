));\n        if (uncatRules.length === 0) return null;\n        return (\n          <div>\n            <SectionLabel right={<Mono style={{ fontSize: 10, color: Z.inkFaint }}>{uncatRules.length}</Mono>}>\n              <span style={{ display: 'inline-flex', alignItems: 'center', gap: 7 }}>\n                <Icon name=\"bolt\" size={13} style={{ color: Z.inkFaint }} />\n                <span style={{ color: Z.inkFaint }}>bez kategorie</span>\n              </span>\n            </SectionLabel>\n            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>\n              {uncatRules.map(rule => {\n                const i = ruleIndex(rule);\n                return (\n                  <GlobalRuleCard accent={accent} agents={agents} dragState={drag} index={i}\n                    key={rule.id} onDelete={del} onEdit={r => setEditing(r)}\n                    onReorder={onReorder} rule={rule} skills={skills} />\n                );\n              })}\n            </div>\n          </div>\n        );\n      })", "source_file": "/Users/zibby/Workspace/z.i.b.b.y/z-i-b-b-y/project/zibby/gate-rules-page.jsx", "source_location": "L226"}]}