{
  "name": "z.i.b.b.y",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "web:dev": "next dev apps/web",
    "web:start": "next start apps/web",
    "web:build": "next build apps/web",
    "web:test": "vitest run --project web",
    "api:dev": "LOG_LEVEL=debug npm run dev --workspace=apps/api",
    "api:dev:test": "ZIBBY_DATA_DIR=apps/api/data-test npm run dev --workspace=apps/api",
    "api:start": "pnpm --filter @zibby/api serve",
    "api:start:test": "ZIBBY_DATA_DIR=apps/api/data-test pnpm --filter @zibby/api serve",
    "api:test": "vitest run --project api",
    "api:smoke": "node apps/api/scripts/claude-smoke.mjs",
    "seed": "node apps/api/scripts/seed.mjs",
    "seed:test": "ZIBBY_DATA_DIR=apps/api/data-test node apps/api/scripts/seed.mjs",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 -c libs/design-system/.storybook",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.59.0",
    "@uiw/react-md-editor": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.77.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.4",
    "storybook": "^8.4.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
