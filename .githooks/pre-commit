#!/bin/sh
# Self-Knowledge drift gate (Fáze 1 — docs/plans/phase-06.md). Refuses a commit
# whose agents/pipelines/gate-rules/channels drifted from the committed
# self-knowledge vault note, so the note never silently goes stale.
#
# Tolerant by design: this hook must never block a commit just because the repo
# isn't `pnpm install`ed yet (e.g. a fresh clone, or a commit made before the
# first install) — it skips with a note instead of failing in that case.

if [ ! -d node_modules ] || [ ! -d apps/api/node_modules ]; then
  echo "[pre-commit] node_modules missing — skipping check:self-knowledge (run pnpm install)."
  exit 0
fi

pnpm check:self-knowledge
CHECK_STATUS=$?

# --- graphify-out staleness warning (Fáze 10 — non-blocking, always exits 0) ---
# graphify-out/ is entirely gitignored (never committed — see
# docs/plans/phase-10-graphify-self-knowledge.md's "Rozhodnutí"), so this is
# purely a local nudge: it never fails the commit, only prints a hint. Run in a
# subshell so its own `exit 0` can't clobber $CHECK_STATUS above — the real
# drift gate — which is what the script exits with below.
(
  REPORT="graphify-out/GRAPH_REPORT.md"

  if [ ! -f "$REPORT" ]; then
    echo "[pre-commit] graphify-out/GRAPH_REPORT.md not found — run \`/graphify\` to generate it."
    exit 0
  fi

  STALE=0
  for FILE in $(git diff --cached --name-only --diff-filter=ACMR -- apps libs); do
    if [ -f "$FILE" ] && [ "$FILE" -nt "$REPORT" ]; then
      STALE=1
      break
    fi
  done

  if [ "$STALE" = "1" ]; then
    echo "[pre-commit] graphify-out may be stale — run \`graphify update .\`."
  fi

  exit 0
)

exit "$CHECK_STATUS"
