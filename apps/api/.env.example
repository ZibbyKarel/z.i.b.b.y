PORT=3333
CORS_ORIGIN=http://localhost:3000

# Data root — the single switch for which on-disk store the API reads/writes.
# Unset → live/dev root `.zibby/data/`. Relative paths resolve from the repo
# root (so `.zibby/data-test` is a sibling of the default). Every `*_DIR` var
# still overrides its own store on top of this. The `:test` npm scripts
# (api:dev:test, api:start:test, seed:test) set this to `.zibby/data-test`.
# ZIBBY_DATA_DIR=.zibby/data-test

AGENT_RUNNER_MODE=demo
AGENT_DEMO_STEPS=25
AGENT_DEMO_DELAY_MS=1000
AUTOMATION_TICK_MS=60000
PIPELINE_DEMO_FAIL_PHASES=

# speakd — local Czech TTS daemon (~/Workspace/tts, loopback-only). Unset →
# defaults below; only set SPEAKD_TOKEN if the daemon's config.toml sets
# [daemon] token (bearer auth is off by default).
# SPEAKD_URL=http://127.0.0.1:8899
# SPEAKD_TIMEOUT_MS=30000
# SPEAKD_TOKEN=
