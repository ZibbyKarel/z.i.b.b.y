{
  "appId": "com.zibby.zibbyos",
  "productName": "ZibbyOS",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "afterSign": "scripts/adhoc-sign.cjs",
  "files": ["dist/**/*", "package.json"],
  "extraResources": [
    { "from": "resources/api", "to": "api" },
    { "from": "resources/web", "to": "web" },
    { "from": "resources/build-info.json", "to": "build-info.json" }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip", "dir"],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "ZibbyOS"
  }
}
